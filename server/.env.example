PORT=3001

# Produção (dinheiro cai na conta em que você copiou as chaves):
# MP_ACCESS_TOKEN e MP_PUBLIC_KEY começam com APP_USR-
# Teste (não cobra): prefixo TEST-
# Nunca commite o arquivo .env nem cole o Access Token no GitHub.
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=

# true = demonstração local, sem Mercado Pago
# false = abre o Checkout Pro se houver token
DEMO_PAYMENTS=false

# true = sandbox mesmo com token APP_USR- (não use isso em produção)
MP_TEST_MODE=false

# Em produção (live) a lista é obrigatória. Sem ela o navegador não chama a API.
MAX_INSTALLMENTS=3
FREE_SHIPPING_FROM=360
PUBLIC_SITE_URL=http://127.0.0.1:3001
PUBLIC_API_URL=
ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001,http://localhost:8080,http://127.0.0.1:8080,https://SEU-USUARIO.github.io

# HTTPS da API (Render preenche RENDER_EXTERNAL_URL sozinho).
# NOTIFICATION_URL=https://ceme-checkout.onrender.com/api/webhooks/mercadopago
# Segredo em Suas integrações → Webhooks. Sem isso o webhook em produção fica sem HMAC.
MP_WEBHOOK_SECRET=

# No Render o Blueprint cria o Postgres e preenche DATABASE_URL. Sem isso o histórico some.
DATABASE_URL=
# Disco permanente do Render (render.yaml monta /data). Só para cópia local/teste.
# ORDERS_DISK=/data
# ORDERS_FILE=/data/orders.json

# Senha da página /envios.html (lista para postar). Não commite a senha real.
# O painel não aparece no menu público: abra /envios.html direto.
ADMIN_KEY=

# Avisos de envio: “saiu hoje, prazo de 3 dias” e “chega amanhã” (Render → Environment).
# No Gmail: conta → segurança → senha de app. Nunca no GitHub.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# WhatsApp automático (API oficial da Meta). Sem isso o site NÃO dispara sozinho no celular do cliente.
# Meta for Developers → WhatsApp → token permanente + Phone number ID.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Celular do dono para aviso de nova venda (DDI 55…). Não use o mesmo número da API.
STORE_ALERT_PHONE=
